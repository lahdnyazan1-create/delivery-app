# ============================================================
# متغيرات البيئة المطلوبة — انسخ هذا الملف إلى .env.local واملأ القيم
# ============================================================

# ---------- Firebase (العميل) — من إعدادات المشروع في Firebase Console ----------
# Project settings → General → Your apps → SDK setup and configuration
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# ---------- FCM (الإشعارات الفورية) ----------
# Firebase Console → Project settings → Cloud Messaging → Web Push certificates
NEXT_PUBLIC_FCM_VAPID_KEY=

# ---------- Firebase Admin (جهة الخادم فقط — Route Handlers / SSR) ----------
# Firebase Console → Project settings → Service accounts → Generate new private key
# ملاحظة: PRIVATE_KEY يحتاج \n داخل علامتي الاقتباس — أو استخدم
# FIREBASE_SERVICE_ACCOUNT بملف JSON كامل في سطر واحد (أسهل على Vercel)
FIREBASE_ADMIN_PROJECT_ID=
FIREBASE_ADMIN_CLIENT_EMAIL=
FIREBASE_ADMIN_PRIVATE_KEY=
# FIREBASE_SERVICE_ACCOUNT=

# ============================================================
# ملاحظات:
# - مسارات OTP (WhatsApp/Twilio/Green API) حُذفت نهائياً بعد التحول
#   لتسجيل الدخول بالبريد وكلمة السر — متغيراتها لم تعد مطلوبة.
# - Cloud Functions لا تحتاج متغيرات بيئة — تُنشر عبر firebase-tools.
# - النشر على Vercel: أضف نفس المتغيرات في Environment Variables
#   (بما فيها FIREBASE_ADMIN_*) كي يعمل SSR وإلا تتراجع الصفحات لجلب
#   العميل (أبطأ لكنه لا يتعطل).
# ============================================================
