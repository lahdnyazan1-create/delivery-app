# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Firebase service account keys
scripts/serviceAccountKey.json
scripts/*.json

# Development tools
merge_files.py
project_context_report.txt
fix.sh

# Functions compiled output
functions/lib/**/*.js
functions/lib/**/*.js.map

# Compiled functions output
functions/lib/

# TypeScript build info
tsconfig.tsbuildinfo
.env*.local
functions/lib
.env.local
