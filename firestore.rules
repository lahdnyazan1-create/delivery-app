rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() { return request.auth != null; }
    
    // ✅ قراءة آمنة لوثيقة المستخدم مع معالجة حالة عدم الوجود
    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }
    
    function role() { 
      let userData = getUserData();
      return userData != null ? userData.role : null;
    }
    
    function isAdmin() { return isSignedIn() && role() == 'admin'; }
    function isCourier() { return isSignedIn() && role() == 'courier'; }
    function isVendor() { return isSignedIn() && role() == 'vendor'; }
    
    function restaurantOwnerId(restaurantId) { 
      let restData = get(/databases/$(database)/documents/restaurants/$(restaurantId)).data;
      return restData != null ? restData.ownerId : null;
    }
    
    function isRestaurantOwner(restaurantId) { 
      return isSignedIn() && restaurantId != null && restaurantOwnerId(restaurantId) == request.auth.uid; 
    }

    match /users/{userId} {
      // ✅ المستخدم يقرأ ملفه، والأدمن الكل، وأي مستخدم مسجل يقرأ
      //    ملفات المندوبين (للاتصال أثناء التوصيل — لا يعتمد على referralCode)
      allow read: if isSignedIn() && (request.auth.uid == userId || isAdmin() || resource.data.role == 'courier');

      // ✅ إنشاء الملف الشخصي عند أول تسجيل دخول — قيود صارمة:
      //    المستخدم نفسه فقط، بدور customer حصراً. رقم الهاتف يُدخل يدوياً
      //    (لا يوجد phone_number في توكن الدخول بالبريد) لذا تُقبل الحقول
      //    الجديدة: email / age / gender بجانب حقول الهاتف القديمة
      allow create: if isSignedIn()
        && request.auth.uid == userId
        && request.resource.data.role == 'customer'
        && request.resource.data.keys().hasOnly(['uid', 'phone', 'displayName', 'email', 'age', 'gender', 'role', 'address', 'createdAt']);

      // ✅ المستخدم يمكنه تحديث بياناته فقط دون تغيير الدور أو كود الدعوة
      //    (referralCode يُدار حصراً عبر generateCourierReferralCode — لو سمحنا
      //    للعميل بتعيينه لاستطاع سائق انتحال كود سائق آخر وسرقة دعواته)
      allow update: if isAdmin() || (isSignedIn() && request.auth.uid == userId
        && request.resource.data.role == resource.data.role
        && request.resource.data.referralCode == resource.data.referralCode
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['displayName', 'phone', 'email', 'age', 'gender', 'address', 'locationLabel', 'lat', 'lng', 'updatedAt', 'fcmTokens']));

      allow delete: if isAdmin();
    }

    match /restaurants/{restaurantId} {
      allow read: if true;
      allow create: if isAdmin();
      // ✅ مالك المطعم يمكنه فتح/إغلاق مطعمه (active فقط)
      allow update: if isAdmin()
        || (isRestaurantOwner(restaurantId)
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['active', 'updatedAt']));
      allow delete: if isAdmin();
    }
    match /dishes/{dishId} { allow read: if true; allow create: if isAdmin(); allow update: if isAdmin() || (isRestaurantOwner(resource.data.restaurantId) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['available', 'updatedAt'])); allow delete: if isAdmin(); }
    // ✅ أكواد الخصم: قراءة للأدمن فقط — التحقق من صلاحية كود يتم عبر
    //    checkPromo Callable (كانت read متاحة للجميع فتُحصر كل الأكوام النشطة)
    match /promoCodes/{code} { allow read: if isAdmin(); allow write: if isAdmin(); }
    
    // ✅ السائق يقرأ ملفه فقط + الأدمن يقرأ الكل
    match /drivers/{driverId} { 
      allow read: if isSignedIn() && (request.auth.uid == driverId || isAdmin()); 
      allow write: if isAdmin(); 
    }
    
    // ✅ محفظة السائق: القراءة للسائق نفسه والأدمن، الكتابة للأدمن فقط
    match /driverWallets/{driverId} { 
      allow read: if isSignedIn() && (request.auth.uid == driverId || isAdmin()); 
      allow write: if isAdmin(); 
    }

    match /categories/{id} { allow read: if true; allow write: if isAdmin(); }
    match /banners/{id} { allow read: if true; allow write: if isAdmin(); }
    match /zones/{zoneId} { allow read: if true; allow write: if isAdmin(); }

    // ✅ التقييمات الفعلية: قراءة عامة (لعرض المتوسط والتعليقات)، الكتابة
    //    حصراً عبر rateOrder Cloud Function (Admin SDK يتجاوز القواعد)
    //    — يضمن تقييماً واحداً لكل طلب مُسلَّم من صاحبه فقط
    match /ratings/{ratingId} { allow read: if true; allow write: if false; }
    
    match /notifications/{notificationId} {
      allow read: if isSignedIn() && (resource.data.userId == request.auth.uid || (resource.data.audience == "couriers" && isCourier()) || isAdmin());
      allow create: if false;
      allow update: if isSignedIn() && resource.data.userId == request.auth.uid && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read']);
      allow delete: if isAdmin();
    }

    match /orders/{orderId} {
      // ✅ السائق يرى فقط طلباته الخاصة، المطعم يرى فقط طلبات مطعمه، والزبون يرى طلباته
      // تعديل: السماح للسائقين برؤية الطلبات الجاهزة (Ready) لتوزيعها
      allow read: if isSignedIn()
                  && (resource.data.userId == request.auth.uid
                      || isAdmin()
                      || (isCourier() && (resource.data.courierId == request.auth.uid || resource.data.status == 'Ready' || resource.data.preferredCourierId == request.auth.uid))
                      || (isRestaurantOwner(resource.data.restaurantId)));

      // ✅不允许客户端直接创建 الطلبات - 必须通过 Cloud Function
      allow create: if false;
      
      // ✅ كل تغييرات الحالة تمر عبر Cloud Functions (Admin SDK) — منع الكتابة المباشرة
      allow update: if false;
      allow delete: if isAdmin();
    }
    
    // ✅ مجموعة IdempotencyKeys: كتابة من Cloud Functions فقط
    match /idempotencyKeys/{keyId} {
      allow read: if false;
      allow write: if false;
    }
  }
}
