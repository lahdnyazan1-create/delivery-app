rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function role() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }

    function isAdmin() {
      return isSignedIn() && role() == 'admin';
    }

    function isCourier() {
      return isSignedIn() && role() == 'courier';
    }

    function restaurantOwnerId(restaurantId) {
      return get(/databases/$(database)/documents/restaurants/$(restaurantId)).data.ownerId;
    }

    function isRestaurantOwner(restaurantId) {
      return isSignedIn() && restaurantId != null && restaurantOwnerId(restaurantId) == request.auth.uid;
    }

    // ---------------- users ----------------
    match /users/{userId} {
      allow read: if isSignedIn() && (request.auth.uid == userId || isAdmin());

      allow create: if isSignedIn()
                    && request.auth.uid == userId
                    && request.resource.data.uid == userId
                    && request.resource.data.role == 'customer';

      allow update: if isAdmin()
                    || (isSignedIn() && request.auth.uid == userId
                        && request.resource.data.role == resource.data.role);

      allow delete: if isAdmin();
    }

    // ---------------- restaurants ----------------
    match /restaurants/{restaurantId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ---------------- dishes ----------------
    match /dishes/{dishId} {
      allow read: if true;
      allow create: if isAdmin();
      allow update: if isAdmin()
                    || (isRestaurantOwner(resource.data.restaurantId)
                        && request.resource.data.diff(resource.data)
                             .affectedKeys().hasOnly(['available', 'updatedAt']));
      allow delete: if isAdmin();
    }

    // ---------------- promoCodes ----------------
    match /promoCodes/{code} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ---------------- drivers ----------------
    match /drivers/{driverId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // ---------------- categories ----------------
    match /categories/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ---------------- banners ----------------
    match /banners/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ---------------- orders ----------------
    match /orders/{orderId} {
      allow read: if isSignedIn()
                  && (resource.data.userId == request.auth.uid
                      || isAdmin()
                      || (isCourier() && (resource.data.courierId == request.auth.uid
                                          || resource.data.courierId == null))
                      || isRestaurantOwner(resource.data.restaurantId));

      allow create: if false;

      allow update: if isAdmin()
                    || (isCourier()
                        && resource.data.courierId == null
                        && request.resource.data.courierId == request.auth.uid
                        && request.resource.data.diff(resource.data)
                             .affectedKeys().hasOnly(['courierId', 'status', 'updatedAt']))
                    || (isCourier()
                        && resource.data.courierId == request.auth.uid
                        && request.resource.data.diff(resource.data)
                             .affectedKeys().hasOnly(['status', 'updatedAt']))
                    || (isRestaurantOwner(resource.data.restaurantId)
                        && request.resource.data.diff(resource.data)
                             .affectedKeys().hasOnly(['status', 'updatedAt']));

      allow delete: if isAdmin();
    }
  }
}
