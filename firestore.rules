rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function role() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }

    function isAdmin() {
      return isSignedIn() && role() == 'admin';
    }

    function isCourier() {
      return isSignedIn() && role() == 'courier';
    }

    function restaurantOwnerId(restaurantId) {
      return get(/databases/$(database)/documents/restaurants/$(restaurantId)).data.ownerId;
    }

    function isRestaurantOwner(restaurantId) {
      return isSignedIn() && restaurantId != null && restaurantOwnerId(restaurantId) == request.auth.uid;
    }

    // ---------------- users ----------------
    match /users/{userId} {
      allow read: if isSignedIn() && (request.auth.uid == userId || isAdmin());

      allow create: if isSignedIn()
                    && request.auth.uid == userId
                    && request.resource.data.uid == userId
                    && request.resource.data.role == 'customer';

      allow update: if isAdmin()
                    || (isSignedIn() && request.auth.uid == userId
                        && request.resource.data.role == resource.data.role);

      allow delete: if isAdmin();
    }

    // ---------------- restaurants ----------------
    match /restaurants/{restaurantId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ---------------- dishes ----------------
    match /dishes/{dishId} {
      allow read: if true;
      allow create: if isAdmin();
      allow update: if isAdmin()
                    || (isRestaurantOwner(resource.data.restaurantId)
                        && request.resource.data.diff(resource.data)
                             .affectedKeys().hasOnly(['available', 'updatedAt']));
      allow delete: if isAdmin();
    }

    // ---------------- promoCodes ----------------
    match /promoCodes/{code} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ---------------- drivers ----------------
    match /drivers/{driverId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // ---------------- categories ----------------
    match /categories/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ---------------- banners ----------------
    match /banners/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ---------------- zones (جديد) ----------------
    // قراءة عامة لأن العميل يحتاج عرض قائمة المناطق ورسومها عند الطلب.
    // الكتابة (إنشاء/تعديل رسوم منطقة) للإدارة فقط.
    match /zones/{zoneId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ---------------- driverWallets (جديد) ----------------
    // المندوب يقرأ محفظته فقط، الإدارة تقرأ الكل.
    // لا كتابة من العميل إطلاقاً — التحديث فقط عبر updateOrderStatus/settleDriverCash
    // اللتين تعملان بصلاحيات Admin SDK وتتجاوزان هذه القواعد.
    match /driverWallets/{driverId} {
      allow read: if isSignedIn() && (request.auth.uid == driverId || isAdmin());
      allow write: if isAdmin();
    }

    // ---------------- notifications (جديد) ----------------
    // تُنشأ فقط من onOrderStatusChanged (Admin SDK). العميل يقرأ إشعاراته فقط
    // ويستطيع تعليمها كمقروءة (تحديث حقل read فقط).
    match /notifications/{notificationId} {
      allow read: if isSignedIn()
                  && (resource.data.userId == request.auth.uid 
                      || (resource.data.audience == "couriers" && isCourier())
                      || isAdmin());
      allow create: if false;
      allow update: if isSignedIn()
                    && resource.data.userId == request.auth.uid
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read']);
      allow delete: if isAdmin();
    }

    // ---------------- orders ----------------
    match /orders/{orderId} {
      allow read: if isSignedIn()
                  && (resource.data.userId == request.auth.uid
                      || isAdmin()
                      || (isCourier() && (resource.data.courierId == request.auth.uid
                                          || (resource.data.courierId == null && resource.data.status == "Ready")))
                      || isRestaurantOwner(resource.data.restaurantId));

      // الإنشاء حصراً عبر placeOrder (Admin SDK)
      allow create: if false;

      // ✅ تم إغلاق تعديل status/courierId من العميل بالكامل.
      // كل انتقالات الحالة (قبول/تحضير/جاهز/استلام/تسليم/إلغاء) تمر إلزامياً
      // عبر updateOrderStatus Cloud Function التي تفرض State Machine وتتحقق
      // من الصلاحيات، وتكتب بصلاحيات Admin SDK (تتجاوز هذه القواعد أصلاً).
      // ما تبقّى مسموحاً به هنا هو فقط تعديلات هامشية لا تمس دورة حياة الطلب.
      allow update: if isAdmin()
                    || (isRestaurantOwner(resource.data.restaurantId)
                        && request.resource.data.diff(resource.data)
                             .affectedKeys().hasOnly(['etaMinutes', 'updatedAt']));

      allow delete: if isAdmin();
    }
  }
}
